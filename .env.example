# Copy to .env and fill in. .env is git-ignored: never commit real keys or passwords.

# Driving distances from the Google Routes API (Compute Routes Essentials). Free up to Google's monthly
# allowance for that SKU (10,000 requests); MoveOps caches routes and stops at the limit below, then
# falls back to the free estimate. Leave the key empty to use only the free estimate.
GOOGLE_MAPS_API_KEY=AIzaSyBWu57n7X_tk0_XLCbhCUh6KhqGz9iDtdw
GOOGLE_ROUTES_MONTHLY_LIMIT=5000

# Free estimate (fallback, or the only method without a key): addresses are located with the US Census Bureau geocoder (no key,
# no account), then miles = straight-line distance x ROAD_DISTANCE_FACTOR.
# GEOCODER=off uses only ZIP code centres from the zip_codes table and never goes online.
GEOCODER=census
ROAD_DISTANCE_FACTOR=1.2

# Where crews start each day; the first stop in emailed directions.
YARD_ADDRESS=

# Outgoing email for crew directions. Gmail / Google Workspace: smtp.gmail.com, port 465,
# your address as SMTP_USER and an app password (not your normal password) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Database file (default data/moveops.db)
# DB_FILE=data/live.db

# Set to 1 when MoveOps is served over HTTPS, so the login cookie is only ever sent encrypted.
# COOKIE_SECURE=1
